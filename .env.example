NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://evty:replace-me@localhost:5432/evty?schema=public"
CORS_ORIGIN=http://localhost:3000
# Required in production. Generate a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Configure provider credentials only in deployment secrets; never commit them.
PAYMENT_PROVIDER=unconfigured
