NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/evty?sslmode=require"
# Direct/unpooled Neon URL: Prisma migrations and schema administration only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/evty?sslmode=require"
# Set demo only on isolated demo/preview deployments. Never seed production.
DATABASE_ENV=demo
ALLOW_DEMO_SEED=false
CORS_ORIGIN=http://localhost:3000
# Required in production. Generate a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Payment routing is server-side. Keep OPay as the primary provider.
PAYMENT_PRIMARY_PROVIDER=opay
PAYMENT_SECONDARY_PROVIDER=paystack
# Keep false until OPay merchant onboarding, credentials and joint testing pass.
OPAY_ENABLED=false
OPAY_ENV=test
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_PRIVATE_KEY=
OPAY_CALLBACK_URL=https://evty-api.onrender.com/api/v1/payments/opay/webhook
OPAY_RETURN_URL=https://evty-web.onrender.com/payment/return
OPAY_CANCEL_URL=https://evty-web.onrender.com/payment/cancel
# Paystack is prepared as a secondary provider; use test credentials first.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://evty-web.onrender.com/payment/return
